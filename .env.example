# ==========================================
# AuraStream - Spotify Offline Configuration
# ==========================================

# Application
APP_NAME=AuraStream - Spotify Offline Player
DEBUG=True
SECRET_KEY=aura-stream-super-secret-key-spotify-offline-2026
FRONTEND_URL=http://localhost:3000

# Spotify API & OAuth
# The client key provided for Spotify API access
SPOTIFY_CLIENT_ID=cEYpjA9oz9GiPac4AsH4n
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/auth/spotify/callback
SPOTIFY_SCOPES=user-read-private user-read-email playlist-read-private playlist-read-collaborative user-library-read

# Database (Default: Async SQLite, or PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./spotify.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/spotify_offline_db

# Redis (Optional in local direct mode, used in Docker Compose)
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_PATH=./storage
STORAGE_BACKEND=local

# S3 (Optional for cloud storage)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=spotify-offline-audio

# Download Queue Preferences
DEFAULT_CONCURRENCY=3
